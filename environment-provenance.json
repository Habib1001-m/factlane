{
  "schema_version": 1,
  "policy": "REUSE_FIRST_VERIFY_BEFORE_REUSE_PROVENANCE_ALWAYS",
  "runtime": {
    "python": {
      "requirement": "CPython >=3.11",
      "reacquire_method": "Use a compatible CPython runtime through the project environment."
    },
    "uv": {
